    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
